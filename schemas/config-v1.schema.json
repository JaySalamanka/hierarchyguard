{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/assettree-ci/schemas/config-v1.schema.json",
  "title": "AssetTree CI configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "columns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "parent": { "type": "string", "minLength": 1, "maxLength": 256 },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "path": { "type": "string", "minLength": 1, "maxLength": 256 },
        "level": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rootPolicy": { "enum": ["any", "one"] },
        "maxDepth": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
        "requireParentBeforeChild": { "type": "boolean" },
        "pathSeparator": { "type": "string", "minLength": 1, "maxLength": 16 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failOn": { "enum": ["error", "warning", "none"] }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFiles": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxBytesPerFile": { "type": "integer", "minimum": 1024, "maximum": 5000000 },
        "maxRowsPerFile": { "type": "integer", "minimum": 1, "maximum": 50000 },
        "maxColumns": { "type": "integer", "minimum": 3, "maximum": 100 },
        "maxFieldLength": { "type": "integer", "minimum": 16, "maximum": 10000 },
        "maxFindings": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    }
  }
}
